{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-web3-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "gateway-demo.pnlflex.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://github.com,https://pnlflex.xyz"
  },
  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "06a4afe4f4cc429fb3841fb39cd6643d"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
